{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "warn",
    "respectEslintDisableDirectives": false,
    "typeAware": true
  },
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "ignorePatterns": ["/test/fixtures/"],
  "env": {
    "builtin": true
  }
}
