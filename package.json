{
  "$schema": "https://raw.githubusercontent.com/vitejs/vite-plugin-registry/refs/heads/main/data/schema/extended-package-json.schema.json",
  "name": "ecij",
  "version": "0.7.0",
  "description": "Zero-runtime CSS-in-JS for Rolldown and Vite: statically extracts css tagged template literals",
  "keywords": [
    "css",
    "css-in-js",
    "rolldown",
    "rolldown-plugin",
    "vite",
    "vite-plugin",
    "zero-runtime"
  ],
  "license": "MIT",
  "author": "Nicolas Stepien",
  "repository": "github:nstepien/ecij",
  "files": [
    "dist",
    "index.d.ts",
    "index.js",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./plugin": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "rolldown -c",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:package": "publint --strict",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "publint": "^0.3.25",
    "rolldown": "^1.3.1",
    "rolldown-plugin-dts": "^0.29.0",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "rolldown": "^1.2.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.2.1",
      "onFail": "ignore"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "ignore"
    }
  },
  "compatiblePackages": {
    "schemaVersion": 1,
    "rollup": {
      "type": "incompatible",
      "reason": "Uses Rolldown-specific APIs"
    }
  }
}
