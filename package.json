{
  "$schema": "https://raw.githubusercontent.com/vitejs/vite-plugin-registry/refs/heads/main/data/schema/extended-package-json.schema.json",
  "name": "ecij",
  "version": "0.5.0",
  "description": "Zero-runtime CSS-in-JS for Rolldown and Vite: statically extracts css tagged template literals",
  "keywords": [
    "css",
    "css-in-js",
    "rolldown",
    "rolldown-plugin",
    "vite",
    "vite-plugin",
    "zero-runtime"
  ],
  "license": "MIT",
  "author": "Nicolas Stepien",
  "repository": "github:nstepien/ecij",
  "files": [
    "dist",
    "index.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./plugin": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "rolldown -c",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rolldown": "^1.2.6",
    "rolldown-plugin-dts": "^0.28.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "rolldown": "^1.2.0",
    "vite": "^8.2.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "compatiblePackages": {
    "schemaVersion": 1,
    "rollup": {
      "type": "incompatible",
      "reason": "Uses Rolldown-specific APIs"
    }
  }
}
