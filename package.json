{
  "name": "ecij",
  "version": "0.3.0",
  "description": "Rolldown and Vite plugin to Extract CSS-in-JS",
  "keywords": [
    "css-in-js"
  ],
  "homepage": "https://github.com/nstepien/ecij#readme",
  "bugs": {
    "url": "https://github.com/nstepien/ecij/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nstepien/ecij.git"
  },
  "license": "MIT",
  "author": "Nicolas Stepien",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./plugin": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "index.js",
  "files": [
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "build": "rolldown -c",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@vitest/coverage-v8": "^4.0.18",
    "prettier": "^3.8.1",
    "rolldown": "1.0.0-rc.5",
    "rolldown-plugin-dts": "^0.22.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.0-beta.16",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "vite": "$vite"
  }
}
